DATABASE_URL=postgresql://keepany:change-me@127.0.0.1:5432/keepany
# Explicitly choose self-host for a single trusted subject, or bound for pinned commercial JWTs.
KEEPANY_SYNC_AUTH_MODE=self-host
# Generate at least 32 random characters. Never commit the real value.
KEEPANY_SYNC_TOKEN=
# Bound mode only: fixed HTTPS issuer, externally visible sync origin, pinned public JWKS, and approved binding metadata.
# Do not set KEEPANY_SYNC_TOKEN in bound mode. Refresh/state bridging is not yet connected.
KEEPANY_BOUND_ISSUER=
KEEPANY_SYNC_PUBLIC_ORIGIN=
KEEPANY_BOUND_JWKS_JSON=
KEEPANY_BOUND_BINDINGS_JSON=
HOST=127.0.0.1
PORT=8787
# Optional ciphertext attachment storage. Leave bucket empty to disable the routes.
KEEPANY_S3_BUCKET=
KEEPANY_S3_REGION=us-east-1
KEEPANY_S3_ENDPOINT=
KEEPANY_S3_ACCESS_KEY_ID=
KEEPANY_S3_SECRET_ACCESS_KEY=
