DATABASE_URL=postgresql://keepany:change-me@127.0.0.1:5432/keepany
# Explicitly choose self-host for a single trusted subject, or bound for pinned commercial JWTs.
KEEPANY_SYNC_AUTH_MODE=self-host
# Generate at least 32 random characters. Never commit the real value.
KEEPANY_SYNC_TOKEN=
# Bound mode only: pinned commercial issuer/JWKS and externally visible sync origin.
# Do not set KEEPANY_SYNC_TOKEN in bound mode. Publish new commercial public keys before switching signing keys.
KEEPANY_BOUND_ISSUER=
KEEPANY_SYNC_PUBLIC_ORIGIN=
KEEPANY_BOUND_JWKS_JSON=
# Dedicated server-to-server reader identity. Keep the RSA private key in a protected file outside this repo.
# The commercial origin may equal KEEPANY_BOUND_ISSUER but is configured separately and must be fixed.
KEEPANY_BOUND_STATE_COMMERCIAL_ORIGIN=
KEEPANY_BOUND_STATE_READER_ISSUER=
KEEPANY_BOUND_STATE_READER_KID=
KEEPANY_BOUND_STATE_READER_PRIVATE_KEY_FILE=
HOST=127.0.0.1
PORT=8787
# Optional ciphertext attachment storage. Leave bucket empty to disable the routes.
KEEPANY_S3_BUCKET=
KEEPANY_S3_REGION=us-east-1
KEEPANY_S3_ENDPOINT=
KEEPANY_S3_ACCESS_KEY_ID=
KEEPANY_S3_SECRET_ACCESS_KEY=
