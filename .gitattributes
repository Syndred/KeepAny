# Keep Vite's HTML input deterministic across Windows and POSIX builds.
apps/web/index.html text eol=lf
# Workbox hashes public SVG source bytes when creating precache revisions.
apps/web/public/icons/*.svg text eol=lf
# Preserve public upstream package evidence byte-for-byte, including whitespace.
legal/third-party/evidence/** -text -whitespace
legal/third-party/texts/** -text
