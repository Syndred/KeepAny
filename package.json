{
  "name": "stackperch",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "vite apps/web --host 127.0.0.1",
    "build": "tsc --noEmit && vite build apps/web",
    "build:preview": "node scripts/build-preview-release.mjs",
    "verify:preview": "node scripts/verify-preview-release.mjs",
    "build:public-site": "node scripts/build-public-site.mjs",
    "build:mcp": "node scripts/build-mcp-launcher.mjs",
    "pack:mcp": "pnpm build:mcp && npm pack ./dist/mcp-launcher --pack-destination ./dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "biome lint apps/web/src apps/sync-server/src packages"
  },
